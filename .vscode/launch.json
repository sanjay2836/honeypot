{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🛡️ Run All Honeypot Services",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_all.py",
      "console": "integratedTerminal",
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "name": "⚡ Run Attack Simulator",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/simulator/simulate_attacks.py",
      "console": "integratedTerminal",
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "name": "🌐 Backend Analytics & Dashboard (Port 8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--reload"
      ],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal"
    },
    {
      "name": "🔑 SSH Decoy Server (Port 2222)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/decoys/ssh_decoy/server.py",
      "console": "integratedTerminal",
      "env": {
        "BACKEND_API_URL": "http://127.0.0.1:8000/api/events",
        "SSH_PORT": "2222"
      }
    },
    {
      "name": "🕸️ HTTP Decoy Server (Port 8080)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "decoys.http_decoy.app:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8080",
        "--reload"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "BACKEND_API_URL": "http://127.0.0.1:8000/api/events",
        "HTTP_PORT": "8080"
      }
    }
  ]
}
